# Environment Configuration
TEST_ENV=dev

# API Base URLs (by environment)
API_BASE_URL_DEV=https://api-dev.mastersunion.in
API_BASE_URL_PROD=https://api.mastersunion.in
API_BASE_URL_STAGING=https://api-dev.mastersunion.in
API_BASE_URL_TETR=https://tetr.mastersunion.in
API_BASE_URL_AIMER=https://aimer-api.mastersunion.in
API_BASE_URL_COACHLMS=https://api.coachlms.org
API_BASE_URL_ISBF=https://api-isbf.mastersunion.in

# Admin Login Credentials (for cross-functional and admin scenarios)
ADMIN_TEST_EMAIL=admin@example.com
ADMIN_TEST_PASSWORD=password123

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATH=./logs

# Timeout Configuration (in milliseconds)
REQUEST_TIMEOUT=30000
CONNECTION_TIMEOUT=10000

# Feature flags
ENABLE_RECAPTCHA_VERIFICATION=false
ENABLE_PARALLEL_EXECUTION=false

# reCAPTCHA token used on studentLogin. DEV only presence-checks this field (any non-empty
# value passes) - it does not validate a real token there, confirmed live 2026-07-17.
# A known-working real token is kept in the (gitignored) local .env - do NOT commit a real
# token here; this placeholder is fine since dev only checks presence.
DEV_RECAPTCHA_TOKEN=api-test-placeholder
